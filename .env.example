# Copy this file to .env and fill in your own values.
# Without these three Google values the app runs in demo mode using
# data/demo-data.json, so you can try it before setting anything up.

# The long id in your sheet URL:
# https://docs.google.com/spreadsheets/d/THIS_PART_HERE/edit
GOOGLE_SHEET_ID=

# From the service account JSON key file ("client_email").
# Share your sheet with this address as an Editor.
GOOGLE_SERVICE_ACCOUNT_EMAIL=

# From the same JSON file ("private_key"). Keep the quotes and the \n escapes.
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMII...\n-----END PRIVATE KEY-----\n"

# Password for /admin
ADMIN_PASSWORD=admin123
